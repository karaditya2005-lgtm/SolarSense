# SolarSense Platform Production Environment Variables Example
# Copy this template to your production deployment environment or secret manager.
# NEVER commit production secrets, database URIs, or private keys to Git.

# ==========================================
# 1. FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Deployed Backend API endpoint (e.g., https://api-solarsense.onrender.com/api or /api)
VITE_API_URL=
VITE_HERO_IMAGE=/images/hero-solar.jpg

# ==========================================
# 2. BACKEND ENVIRONMENT VARIABLES
# ==========================================
NODE_ENV=production
PORT=5000

# MongoDB Atlas Database Connection
MONGODB_URI=
MONGODB_DB_NAME=solarsense

# Authentication & Cryptographic Keys (Min 32 characters)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Production CORS & Cookies
# Set CORS_ORIGINS to the deployed frontend domain (e.g., https://solarsense.vercel.app)
CORS_ORIGINS=
COOKIE_SECURE=true
# Set COOKIE_SAMESITE=none if frontend and backend are hosted on separate domains over HTTPS
COOKIE_SAMESITE=none
COOKIE_DOMAIN=

# External Meteorological Telemetry (Open-Meteo)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_API_KEY=
WEATHER_TIMEOUT_MS=8000
WEATHER_CACHE_TTL_MINUTES=60

# Decoupled Python ML Microservice Internal Communication
# Set ML_SERVICE_URL to the internal or secure deployed ML service URL
ML_SERVICE_URL=
# Shared internal communication key (Min 16 characters, must match ML service)
ML_INTERNAL_KEY=
ML_TIMEOUT_MS=10000
FORECAST_MAX_HORIZON_DAYS=7

# Logging & Operational Limits
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Initial Platform Administrator Bootstrap Seed (only seeded once on empty DB)
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ==========================================
# 3. MACHINE LEARNING MICROSERVICE
# ==========================================
PORT=8000
ML_INTERNAL_KEY=
ML_MODEL_VERSION=v1.0.0
LOG_LEVEL=info
