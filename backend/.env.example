# SolarSense Backend Environment Variables Example
# Copy this file to .env and provide your actual secrets.
# NEVER commit real credentials to version control.

NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=
MONGODB_DB_NAME=

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Security & CORS
BCRYPT_SALT_ROUNDS=
CORS_ORIGINS=
CLIENT_URL=
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Weather / Solar External Data API
WEATHER_API_BASE_URL=
WEATHER_GEOCODING_BASE_URL=
WEATHER_API_KEY=
WEATHER_TIMEOUT_MS=
WEATHER_CACHE_TTL_MINUTES=

# ML Service Integration
ML_SERVICE_URL=
ML_INTERNAL_KEY=
ML_TIMEOUT_MS=
FORECAST_MAX_HORIZON_DAYS=

# Logging
LOG_LEVEL=

# Initial Administrator Seed
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
